<% layout("/layouts/boilerplate") %> 

<div id="filters">

    <a href="/listings?category=Trending" class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms" class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>

    <a href="/listings?category=Iconic%20Cities" class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=Mountains" class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>

    <a href="/listings?category=Castles" class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </a>

    <a href="/listings?category=Amazing%20Pools" class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </a>

    <a href="/listings?category=Camping" class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>

    <a href="/listings?category=Farms" class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </a>

    <a href="/listings?category=Arctic" class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>

    <a href="/listings?category=Domes" class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>

    <a href="/listings?category=Boats" class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </a>

    <a href="/listings?category=Hotels" class="filter">
        <div><i class="fa-solid fa-hotel"></i></div>
        <p>Hotels</p>
    </a>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input 
                class="form-check-input" 
                type="checkbox" 
                role="switch" 
                id="flexSwitchCheckDefault"
            >

            <label 
                class="form-check-label" 
                for="flexSwitchCheckDefault"
            >
                Display total after taxes
            </label>
        </div>
    </div>

</div>


<% if (allListings.length === 0) { %>

    <div class="text-center mt-5">

        <h3>No listings found</h3>

        <p class="text-muted">
            Try searching for another destination.
        </p>

    </div>

<% } else { %>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% for(let listing of allListings) { %>

        <div class="col">

            <div class="card listing-card">

                <!-- Image + Wishlist -->
                <div class="image-container">

                    <!-- Image is clickable -->
                    <a 
                        href="/listings/<%= listing._id %>" 
                        class="listing-link"
                    >

                        <img 
                            src="<%= listing.image.url %>" 
                            class="card-img-top" 
                            alt="listing_image"
                        >

                    </a>


                    <!-- Wishlist Heart -->
                    <div class="wishlist-container">

                        <% if(currUser) { %>

                            <% const isWishlisted = currUser.wishlist.some(
                                id => id.toString() === listing._id.toString()
                            ); %>


                            <% if(isWishlisted) { %>

                                <!-- Remove from Wishlist -->

                                <form 
                                    method="POST" 
                                    action="/wishlist/<%= listing._id %>?_method=DELETE"
                                >

                                    <button 
                                        type="submit" 
                                        class="wishlist-btn wishlisted"
                                        title="Remove from Wishlist"
                                    >

                                        <i class="fa-solid fa-heart"></i>

                                    </button>

                                </form>


                            <% } else { %>

                                <!-- Add to Wishlist -->

                                <form 
                                    method="POST" 
                                    action="/wishlist/<%= listing._id %>"
                                >

                                    <button 
                                        type="submit" 
                                        class="wishlist-btn"
                                        title="Add to Wishlist"
                                    >

                                        <i class="fa-regular fa-heart"></i>

                                    </button>

                                </form>

                            <% } %>

                        <% } %>

                    </div>

                </div>


                <!-- Listing Details -->
                <a 
                    href="/listings/<%= listing._id %>" 
                    class="listing-link"
                >

                    <div class="card-body">

                        <p class="card-text">

                            <b class="card-title">
                                <%= listing.title %>
                            </b>


                            <span class="card-location">
                                <%= listing.location %>, 
                                <%= listing.country %>
                            </span>


                            <span 
                                class="card-price" 
                                data-price="<%= listing.price %>"
                            >
                                &#8377 <%= listing.price.toLocaleString("en-IN") %>
                            </span>

                            <span>/ night</span>


                            <i class="tax-info">
                                &nbsp; &nbsp; +18% GST
                            </i>

                        </p>

                    </div>

                </a>

            </div>

        </div>

    <% } %>

</div>

<% } %>